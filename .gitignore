# Windows-Vorschaudateien
Thumbs.db
desktop.ini

# Arbeitsordner fuer neue Projekte (Rohbilder und Projekt-Textdatei)
projekte/_NEUES_PROJEKT/bilder_input/*
projekte/_NEUES_PROJEKT/*.txt

# Python
__pycache__/

# Hero-Bilder in Bearbeitung, nicht veroeffentlichen
hero/archiv/
hero/NEU/

# Interne Arbeitsdokumente, nicht veroeffentlichen
*.docx
*.xlsx
*.pdf

# Testseiten, nicht veroeffentlichen
projekte/*/test-*.html

# Archivierte Projektseiten (lokal)
projekte/*/archiv/
